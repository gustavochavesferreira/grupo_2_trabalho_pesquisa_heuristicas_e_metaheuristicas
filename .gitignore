/bin/
/obj/

# Instâncias brutas são fornecidas manualmente pelo usuário.
/instances/source/*
!/instances/source/README.md

# Resultados gerados; instruções e diretórios permanecem versionados.
/results/*
!/results/README.md

__pycache__/
*.pyc
*~
*.swp
.DS_Store

/materiais_uteis_para_consulta/

# Prompts locais
/PROMPT_MESTRE_TA.md
/PROMPT_MESTRE.md

# Artefatos científicos da calibração da Tarefa 21.
!/results/calibration/
/results/calibration/**/.pendentes/
/results/calibration/**/invalidos/

# Pré-execução: versionar somente plano e comprovação técnica.
!/results/preflight/
/results/preflight/*
!/results/preflight/plano.json
!/results/preflight/integridade.json
!/results/preflight/retomada.json

# Piloto formal: preservar dados brutos, resumos e ambiente no versionamento.
!/results/pilot/
/results/pilot/**/.pendentes/
/results/pilot/**/invalidos/
